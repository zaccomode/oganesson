{
	"name": "oganesson-svelte",
	"version": "0.2.0",
	"description": "Svelte implementation of the Oganesson design system, built on Bits UI.",
	"keywords": [
		"svelte",
		"design-system",
		"components",
		"oganesson",
		"bits-ui"
	],
	"homepage": "https://github.com/zaccomode/oganesson/tree/main/svelte",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zaccomode/oganesson.git",
		"directory": "svelte"
	},
	"bugs": {
		"url": "https://github.com/zaccomode/oganesson/issues"
	},
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles.css": "./dist/styles/index.css",
		"./fonts.css": "./dist/styles/fonts.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --project server",
		"test": "vitest --run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test:stories": "vitest --project storybook"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.6.8",
		"@storybook/addon-docs": "^10.6.8",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/addon-vitest": "^10.6.8",
		"@storybook/sveltekit": "^10.6.8",
		"@sveltejs/adapter-auto": "^9.0.0",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.1.0",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.25",
		"storybook": "^10.6.8",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@fontsource/geist-mono": "^5.3.0",
		"@fontsource/instrument-sans": "^5.3.0",
		"@lisse/core": "^0.7.3",
		"@lisse/svelte": "^0.7.3",
		"@lucide/svelte": "^1.79.0",
		"bits-ui": "^2.22.0",
		"esm-env": "^1.2.2",
		"svelte-toolbelt": "^0.13.0"
	},
	"peerDependencies": {
		"svelte": "^5.32.0"
	}
}
